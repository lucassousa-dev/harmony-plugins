@HarmonyPlugins.Api_HostAddress = http://localhost:5224

GET {{HarmonyPlugins.Api_HostAddress}}/api/health
Accept: application/json

###

POST {{HarmonyPlugins.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Cliente Exemplo",
  "email": "cliente@example.com",
  "password": "uma-senha-longa-de-teste"
}

###

POST {{HarmonyPlugins.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "cliente@example.com",
  "password": "uma-senha-longa-de-teste"
}

###

# Cole aqui o refreshToken devolvido pelo login.
POST {{HarmonyPlugins.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "cole-o-token-de-renovacao"
}

###

GET {{HarmonyPlugins.Api_HostAddress}}/api/catalog/plugins?search=loja&type=Paid&maxPrice=50
Accept: application/json

###

# Rotas de administrador: faça login com a conta criada em Admin:Email e cole o token.
@adminToken = cole-o-token-do-administrador

POST {{HarmonyPlugins.Api_HostAddress}}/api/admin/games
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Minecraft"
}

###
