# Copie para .env e troque os valores. O .env não é versionado.

# Senha do usuário sa do SQL Server: mínimo de 8 caracteres, com maiúsculas,
# minúsculas, números e símbolos. Não use ";" (quebra a connection string).
MSSQL_SA_PASSWORD=Troque-Esta-Senha-123

# Chave de assinatura dos tokens JWT: pelo menos 32 bytes.
JWT_KEY=troque-por-uma-chave-secreta-com-pelo-menos-32-bytes

# Primeiro administrador, criado na inicialização se ainda não existir nenhum.
# Senha de 15 a 64 caracteres.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-por-uma-senha-longa
